# =========================================================================
# Linkly - Next.js & Supabase Environment Configuration
# =========================================================================

# Supabase Project Credentials (Create free project at https://supabase.com)
# Run the SQL commands from supabase_schema.sql in your Supabase SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Port (Optional: default is 5173)
PORT=5173
